<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ActionBarProgress" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:maxHeight">16.0dip</item>
        <item name="android:progressDrawable">@drawable/ab_progress</item>
        <item name="android:minHeight">16.0dip</item>
    </style>
    <style name="ActionBarSpinner" parent="@android:style/Widget.Holo.Spinner">
        <item name="android:background">@drawable/spinner_ab_holo_dark</item>
    </style>
    <style name="ActionBarStyle" parent="@android:style/Widget.Holo.Light.ActionBar.Solid.Inverse">
        <item name="android:icon">@drawable/ic_ab_app</item>
        <item name="android:progressBarStyle">@style/ActionBarProgress</item>
        <item name="android:background">@drawable/bg_actionbar</item>
        <item name="android:titleTextStyle">@style/ActionBarTitleStyle</item>
        <item name="android:subtitleTextStyle">@style/ActionBarSubtitleStyle</item>
    </style>
    <style name="ActionBarSubtitleStyle" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Subtitle.Inverse">
        <item name="android:textColor">#80ffffff</item>
    </style>
    <style name="ActionBarTitleStyle" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Title.Inverse">
        <item name="android:textColor">#ffffffff</item>
    </style>
    <style name="AppBaseTheme" parent="@android:style/Theme.Light" />
    <style name="AppTheme" parent="@style/AppBaseTheme" />
    <style name="BaseStyle" parent="@android:style/Theme.Holo.Light.DarkActionBar">
        <item name="android:progressBarStyle">@style/ProgressBar</item>
        <item name="android:fadingEdgeLength">0.0dip</item>
        <item name="android:actionBarStyle">@style/ActionBarStyle</item>
        <item name="android:actionDropDownStyle">@style/ActionBarSpinner</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:actionBarDivider">@null</item>
        <item name="ptrHeaderStyle">@style/Widget.VK.PtrHeader</item>
    </style>
    <style name="BaseStyleNoTitle" parent="@android:style/Theme.Holo.Light">
        <item name="android:windowActionBar">false</item>
    </style>
    <style name="BlueButton" parent="@android:style/Widget.Button">
        <item name="android:textSize">16.0dip</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:background">@drawable/btn_light_blue</item>
        <item name="android:singleLine">true</item>
        <item name="android:shadowColor">#19000000</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">1.0E-7</item>
    </style>
    <style name="BlueButton2" parent="@android:style/Widget.Button">
        <item name="android:textSize">16.0dip</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:background">@drawable/btn_light_blue2</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="CardTextEdit" parent="@android:style/Widget.EditText">
        <item name="android:textSize">18.0dip</item>
        <item name="android:textColor">#ff000000</item>
        <item name="android:textColorHint">#ffb8b8b8</item>
        <item name="android:background">@drawable/bg_post</item>
        <item name="android:paddingLeft">20.0dip</item>
        <item name="android:paddingTop">20.0dip</item>
        <item name="android:paddingRight">20.0dip</item>
        <item name="android:paddingBottom">16.0dip</item>
    </style>
    <style name="CardsSectionHeader" parent="@android:style/Widget.TextView">
        <item name="android:textSize">14.0dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ff858585</item>
        <item name="android:paddingLeft">17.0dip</item>
        <item name="android:paddingTop">10.0dip</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="CardsSectionHeaderBlue" parent="@style/CardsSectionHeader">
        <item name="android:textColor">#ff5a87b1</item>
    </style>
    <style name="CustomWindowTitleStyle" parent="@android:style/TextAppearance.WindowTitle">
        <item name="android:textSize">19.0dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">10.0dip</item>
        <item name="android:visibility">gone</item>
        <item name="android:shadowColor">#ff000000</item>
        <item name="android:shadowDx">0.0</item>
        <item name="android:shadowDy">-1.0</item>
        <item name="android:shadowRadius">1.0E-7</item>
    </style>
    <style name="DialogNoTitle" parent="@android:style/Theme.Dialog">
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="EmojiPicker" parent="@style/DialogNoTitle">
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_handle_vertical_white</item>
        <item name="android:windowAnimationStyle">@style/EmojiPickerAnim</item>
    </style>
    <style name="EmojiPickerAnim">
        <item name="android:windowEnterAnimation">@anim/slide_bottom_in_fast</item>
        <item name="android:windowExitAnimation">@anim/fade_out_fast</item>
    </style>
    <style name="EmptyTextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">17.0dip</item>
        <item name="android:textColor">#80000000</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10.0dip</item>
    </style>
    <style name="HoloSpinnerStyle">
        <item name="android:background">@drawable/spinner_holo_light</item>
    </style>
    <style name="LightStyle" parent="@android:style/Theme.Light" />
    <style name="ListSectionHeader" parent="@android:style/Widget.TextView">
        <item name="android:textSize">14.0dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ff33b5e5</item>
        <item name="android:background">@drawable/list_section_header</item>
        <item name="android:padding">8.0dip</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="NoContentOverlay" parent="@style/BaseStyle">
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="NoTitleAndShadow" parent="@style/BaseStyleNoTitle">
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="NotificationText">
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>
    <style name="NotificationTitle">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>
    <style name="PopupIfTablet" parent="@style/BaseStyle" />
    <style name="PopupMenuAnim">
        <item name="android:windowEnterAnimation">@anim/popup_menu_open</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
    <style name="ProgressBar" parent="@android:style/Widget.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/progress_dark</item>
    </style>
    <style name="SmoothProgressBar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="spb_color">@color/spb_default_color</item>
        <item name="spb_stroke_width">@dimen/spb_default_stroke_width</item>
        <item name="spb_stroke_separator_length">@dimen/spb_default_stroke_separator_length</item>
        <item name="spb_sections_count">@integer/spb_default_sections_count</item>
        <item name="spb_speed">@string/spb_default_speed</item>
        <item name="spb_reversed">@bool/spb_default_reversed</item>
        <item name="spb_mirror_mode">@bool/spb_default_mirror_mode</item>
        <item name="spb_progressiveStart_activated">@bool/spb_default_progressiveStart_activated</item>
        <item name="spb_background">@null</item>
        <item name="spb_generate_background_with_colors">false</item>
        <item name="spb_gradients">false</item>
    </style>
    <style name="StickerDialogAnim">
        <item name="android:windowEnterAnimation">@anim/sticker_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/sticker_dialog_out</item>
    </style>
    <style name="TabletPopupMenu" parent="@style/DialogNoTitle">
        <item name="android:windowAnimationStyle">@style/PopupMenuAnim</item>
    </style>
    <style name="Theme.SmoothProgressBarDefaults" parent="@android:style/Theme">
        <item name="spbStyle">@style/SmoothProgressBar</item>
    </style>
    <style name="TranslucentStyle" parent="@android:style/Theme.Translucent.NoTitleBar" />
    <style name="TranslucentStyleWithTitle" parent="@style/BaseStyle">
        <item name="android:windowBackground">@color/window_bg_transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:background">@null</item>
    </style>
    <style name="TranslucentSystemBarsTheme" parent="@style/BaseStyle">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="TransparentTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="VideoPlayer" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/window_bg_black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="VideoPlayer2" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/window_bg_black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="WhiteScrollbarGridView" parent="@android:style/Widget.GridView">
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_handle_vertical_white</item>
    </style>
    <style name="Widget.VK.PtrHeader" parent="@android:style/Widget">
        <item name="ptrProgressBarColor">#ffffffff</item>
        <item name="ptrProgressBarStyle">inside</item>
        <item name="ptrProgressBarHeight">3.0dip</item>
    </style>
    <style name="ampm_label">
        <item name="android:textSize">@dimen/ampm_label_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ampm_text_color</item>
    </style>
    <style name="blueButton2_text">
        <item name="android:textSize">13.0dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:singleLine">true</item>
        <item name="android:shadowColor">#ff4a8dce</item>
        <item name="android:shadowDx">0.0</item>
        <item name="android:shadowDy">-1.0</item>
        <item name="android:shadowRadius">1.0E-8</item>
    </style>
    <style name="day_of_week_label_condensed" />
    <style name="mtext">
        <item name="android:textSize">13.0dip</item>
    </style>
    <style name="time_label">
        <item name="android:textSize">@dimen/time_label_size</item>
        <item name="android:textColor">@color/numbers_text_color</item>
    </style>
</resources>
