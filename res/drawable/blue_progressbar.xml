<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5.0dip" />
            <gradient android:startColor="#ffd1d9e1" android:endColor="#ffd2dce5" android:angle="-90.0" android:type="linear" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:radius="5.0dip" />
                <gradient android:startColor="#ffaabcd0" android:endColor="#ffa5b6c8" android:angle="-90.0" android:type="linear" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:radius="5.0dip" />
                <gradient android:startColor="#ff6b87a7" android:endColor="#ff547295" android:angle="-90.0" android:type="linear" />
            </shape>
        </scale>
    </item>
</layer-list>